<?xml version="1.0" encoding="utf-8"?>
<!-- SC: Source Sans 3, the body font of the desktop launcher (OFL, assets/sc_licencias) -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font android:font="@font/sc_sourcesans_regular" android:fontStyle="normal" android:fontWeight="400"
        app:font="@font/sc_sourcesans_regular" app:fontStyle="normal" app:fontWeight="400" />
    <font android:font="@font/sc_sourcesans_semibold" android:fontStyle="normal" android:fontWeight="600"
        app:font="@font/sc_sourcesans_semibold" app:fontStyle="normal" app:fontWeight="600" />
    <font android:font="@font/sc_sourcesans_bold" android:fontStyle="normal" android:fontWeight="700"
        app:font="@font/sc_sourcesans_bold" app:fontStyle="normal" app:fontWeight="700" />
</font-family>
